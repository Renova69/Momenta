# ==============================================================================
# WedMoments — Environment Configuration Template
# Copy to .env or .env.production and fill in your values
# ==============================================================================

# Server & Database Ports
PORT=6501
DB_PORT=6532
APP_PORT=6501

# PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:postgrespassword@127.0.0.1:6532/wedmoments_db

# Connection pool. Guests upload in bursts, so this needs headroom; keep it
# below the database server's own max_connections.
DB_POOL_MAX=40
DB_CONNECT_TIMEOUT_MS=10000

# Security & JWT Token Signing (Generate a 64+ char random string in production)
JWT_SECRET=wedmoments_jwt_super_secret_key_2026_change_in_prod
JWT_EXPIRES_IN=7d

# Apply pending SQL migrations automatically on server boot (recommended).
# Set to false only if a separate deploy step runs `npm run migrate`.
AUTO_MIGRATE=true

# Storage Provider: 'local' (development) or 'r2' (Cloudflare R2 production)
STORAGE_PROVIDER=local
UPLOADS_DIR=uploads

# Allowed CORS Origins — comma-separated exact origins. Leave EMPTY for a
# same-origin deployment (SPA served by this server). '*' is NOT supported:
# credentials are enabled, so the value is parsed as an explicit allow-list and
# a literal '*' would match no origin at all.
CORS_ORIGIN=

# Public base URL baked into every stored photo/audio URL (thumbnailUrl,
# fullUrl, originalUrl, audioUrl) at upload time. Set to your public host in
# production. Also matters for local LAN testing (a phone on the same
# Wi-Fi scanning the QR code): leaving this at localhost means every photo a
# phone uploads gets a thumbnailUrl of http://localhost:6501/..., which
# resolves to the phone itself, not your dev machine — every image renders
# broken even though the upload succeeded. Set it to your machine's LAN IP
# (e.g. http://192.168.0.35:6501), matching CORS_ORIGIN below.
PUBLIC_BASE_URL=http://localhost:6501

# ------------------------------------------------------------------------------
# Stripe Billing (Optional — real checkout is disabled until both are set)
# ------------------------------------------------------------------------------
# Without these, POST /api/billing/checkout-session returns 503
# STRIPE_NOT_CONFIGURED and the pricing modal falls back automatically to the
# direct self-serve tier write (server/routes/subscriptions.ts) — local dev
# and demos work with zero Stripe setup. No Stripe Dashboard product/price
# needs to exist first either: Checkout Sessions are created with ad-hoc
# price_data matching src/config/plans.ts's amounts directly.
#
# Setting STRIPE_SECRET_KEY also CLOSES that unpaid fallback for paid tiers
# (they then return 403 CHECKOUT_REQUIRED and must go through Stripe), so
# never set it on an environment that is relying on the free self-serve path.
#
# STRIPE_SECRET_KEY: from the Stripe Dashboard (Developers > API keys).
# STRIPE_WEBHOOK_SECRET: from the webhook endpoint you register there,
#   pointed at POST /api/billing/webhook (Developers > Webhooks). Locally,
#   `stripe listen --forward-to localhost:6501/api/billing/webhook` prints
#   one for you.
#
# Subscribe that endpoint to exactly these events — the handler ignores
# everything else, and missing any of them silently breaks a real case:
#   checkout.session.completed              grant a paid tier
#   checkout.session.async_payment_succeeded  grant after a delayed method (SEPA) settles
#   checkout.session.async_payment_failed     log a settlement that never arrived
#   invoice.paid                            monthly renewal; refreshes retention deadlines
#   customer.subscription.updated           catches a subscription ending mid-cycle
#   customer.subscription.deleted           cancellation; downgrades to free
#
# Post-checkout redirect URLs are validated against CORS_ORIGIN plus
# PUBLIC_BASE_URL above. If the SPA is served from an origin missing from
# both, checkout requests are rejected with 400 "Invalid redirect URL".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (`price_...`), one per paid tier. OPTIONAL, and meaningful
# only as a complete set — see below.
#
# Create them in the Stripe Dashboard under Product catalogue: one Product per
# plan, each with one Price. Match src/config/plans.ts exactly:
#   Celebration Pass   49 EUR   one-time
#   Deluxe Keepsake    89 EUR   one-time
#   Pro Planner        49 EUR   recurring, monthly
# Then copy each Price's ID (starts with `price_`, NOT the `prod_` id).
#
# With all three set, the webhook decides the purchased tier from the Price the
# customer was actually charged against, and treats the checkout session's
# `metadata.tier` as a cross-check that must agree — a mismatch grants nothing.
# That matters because metadata is a free-form string editable from the
# Dashboard, while the Price is the record the money moved against.
#
# Leave them blank and checkout builds an ad-hoc price_data line item from
# src/config/plans.ts instead, with the tier coming from metadata alone. That
# works fine; it is just the weaker claim. Partial configuration is treated as
# unconfigured on purpose — two trust levels for one decision hides bugs.
STRIPE_PRICE_CELEBRATION_PASS=
STRIPE_PRICE_DELUXE_KEEPSAKE=
STRIPE_PRICE_PRO_PLANNER=

# Days a Pro Planner subscription keeps its tier after a failed charge, while
# Stripe retries the card. Cutting a paying customer off on the first failure —
# possibly mid-wedding — is worse than carrying them for a week. Enforced by
# the webhook and by `npm run grace:sweep` (see migration 018).
SUBSCRIPTION_GRACE_DAYS=7

# ------------------------------------------------------------------------------
# Scheduled maintenance (the `maintenance` compose service) — see docs/OPERATIONS.md
# ------------------------------------------------------------------------------
# Both sweeps default to REPORT-ONLY. Deleting irreplaceable wedding photos, or
# taking away a plan someone paid for, must never be a side effect of deploying.
# Watch what they *would* do first, then switch these on.
# Where the maintenance sweeps append each run's report, in addition to
# stdout. Reviewing these over several weeks is the prerequisite for ever
# setting RETENTION_ENFORCED=true (see OPEN_ITEMS.md D1).
MAINTENANCE_LOG_DIR=

# ------------------------------------------------------------------------------
# Outbound email (SMTP)
# ------------------------------------------------------------------------------
# Needed for retention warnings. Without SMTP_HOST nothing can be sent, and
# because the retention sweep will not delete an album until its host has been
# warned, RETENTION_ENFORCED=true deletes nothing while this is unset.
# Works with any provider that speaks SMTP: SES, Postmark, Mailgun, Resend, or
# a relay on the same network.
SMTP_HOST=
SMTP_PORT=587
# true only for implicit TLS on port 465; 587 uses STARTTLS automatically.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=WedMoments <noreply@example.com>
# Where notice emails link back to. Falls back to PUBLIC_BASE_URL, which on a
# LAN deployment is something like http://192.168.0.35:6501 — an address no
# recipient can open. Sending refuses outright on a loopback or private-range
# URL: nothing goes out and no album is marked as notified, so nothing becomes
# deletable either. Set this to the address hosts actually use before
# NOTICE_SEND=true.
APP_PUBLIC_URL=

# Send retention warnings, rather than only reporting who is due one.
NOTICE_SEND=false
# How many days before expiry a host is warned.
RETENTION_NOTICE_LEAD_DAYS=14

# How many days of maintenance reports to keep. 0 or "never" keeps them all.
MAINTENANCE_LOG_RETENTION_DAYS=90

RETENTION_ENFORCED=false
GRACE_ENFORCED=false
RETENTION_INTERVAL_HOURS=24
GRACE_INTERVAL_HOURS=1

# Storage orphan sweep (`npm run storage:orphan-report` / `:orphan-sweep`).
# Reclaims media whose event row is gone — nothing cascades from Postgres into
# a filesystem or a bucket, so a row deleted by anything other than the
# retention purge strands its files permanently.
#   SWEEP_CONFIRM=true      required to delete; the report needs nothing
#   MIN_AGE_MINUTES=60      ignore anything newer, so the sweep cannot race an
#                           upload that has written its file but not yet
#                           committed its row
MIN_AGE_MINUTES=60

# Express 'trust proxy' — leave EMPTY (untrusted) when this server is reached
# directly, as the shipped docker-compose.yml does. Only set this when a real
# reverse proxy or load balancer sits in front and sets X-Forwarded-For
# itself; otherwise a client can spoof that header to fake its IP for the
# rate limiters. "1" trusts one hop; an IP/CIDR trusts only that proxy.
# NOTE: in production this is MANDATORY — the server refuses to start without
# it, because getting it wrong is silent and breaks the rate limiters in both
# directions. If nothing sits in front of the app, say so explicitly with
# TRUST_PROXY=false rather than leaving it blank.
TRUST_PROXY=

# ------------------------------------------------------------------------------
# In-process FTP server for in-camera background transfer (default off)
# ------------------------------------------------------------------------------
FTP_ENABLED=false
FTP_PORT=2121
# Reachable IP/hostname advertised for passive mode (required behind NAT / on venue Wi-Fi)
FTP_PASV_URL=
# Staging directory for camera uploads before they are ingested
FTP_STAGING_DIR=ftp-staging
# FTPS (AUTH TLS) — provide cert/key to enable; leave blank for plain FTP
FTP_TLS_CERT=
FTP_TLS_KEY=
# With NODE_ENV=production and no TLS cert/key, the FTP server refuses to
# start (ingest keys would cross the network in cleartext). Set true only as
# a deliberate, informed override — e.g. a trusted wired venue network.
FTP_ALLOW_PLAINTEXT=false

# ------------------------------------------------------------------------------
# Cloudflare R2 Credentials — required when STORAGE_PROVIDER=r2 (config.ts
# refuses to start without R2_ACCOUNT_ID/R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY/
# R2_PUBLIC_URL). See docs/CLOUDFLARE_R2_SETUP_GUIDE.md. R2_BUCKET_NAME alone
# has a safe default if left blank.
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=wedmoments-photos
R2_PUBLIC_URL=
