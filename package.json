{
  "name": "wedmoments",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc --noEmit -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.test.json",
    "preview": "vite preview --port 6500",
    "start": "tsx server/index.ts",
    "server": "tsx server/index.ts",
    "migrate": "tsx server/lib/migrate.ts",
    "notify:verify": "tsx scripts/notify-verify.ts",
    "bounce:list": "tsx scripts/bounces.ts list",
    "bounce:record": "tsx scripts/bounces.ts record",
    "bounce:clear": "tsx scripts/bounces.ts clear",
    "notify:report": "tsx scripts/retention-notify.ts",
    "notify:send": "cross-env NOTICE_SEND=true tsx scripts/retention-notify.ts",
    "admin:reset-password": "tsx scripts/reset-password.ts",
    "retention:report": "tsx scripts/retention-sweep.ts",
    "retention:sweep": "cross-env RETENTION_ENFORCED=true tsx scripts/retention-sweep.ts",
    "retention:rehearse": "tsx scripts/retention-rehearsal.ts",
    "maintenance": "tsx scripts/maintenance-scheduler.ts",
    "maintenance:once": "tsx scripts/maintenance-scheduler.ts --once",
    "db:purge-test-data": "tsx scripts/purge-test-data.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore-check": "tsx scripts/db-restore-check.ts",
    "grace:report": "tsx scripts/subscription-grace-sweep.ts",
    "grace:sweep": "cross-env GRACE_ENFORCED=true tsx scripts/subscription-grace-sweep.ts",
    "storage:recount": "tsx scripts/storage-recount.ts",
    "loadtest": "tsx scripts/load-test.ts",
    "storage:orphans": "tsx scripts/storage-orphans.ts",
    "storage:orphan-report": "tsx scripts/storage-orphan-sweep.ts",
    "storage:orphan-sweep": "cross-env SWEEP_CONFIRM=true tsx scripts/storage-orphan-sweep.ts",
    "r2:lifecycle": "tsx scripts/r2-lifecycle.ts",
    "r2:lifecycle:apply": "cross-env LIFECYCLE_APPLY=true tsx scripts/r2-lifecycle.ts",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "cross-env STORAGE_PROVIDER=local vitest run",
    "test:unit:serial": "cross-env STORAGE_PROVIDER=local vitest run --no-file-parallelism",
    "test:storage:r2": "vitest run --config vitest.r2.config.ts",
    "test:coverage": "cross-env STORAGE_PROVIDER=local vitest run --coverage",
    "test:e2e": "cross-env STORAGE_PROVIDER=local tsx tests/e2e.test.ts",
    "test:browser": "vite build && playwright test",
    "ingest:watch": "tsx scripts/ingest-watcher.ts",
    "tunnel": "node start-tunnel.cjs",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"server/**/*.ts\" \"shared/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.{ts,tsx}\"",
    "audit:ci": "tsx scripts/audit-gate.ts",
    "mutate": "node scripts/mutate.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@electerm/ftp-srv": "^1.0.6",
    "@fontsource-variable/sofia-sans": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.59.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "stripe": "^22.6.2",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.27",
    "axe-core": "^4.14.0",
    "basic-ftp": "^6.2.3",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "js-yaml": "^4.3.2",
    "jsdom": "~30.0.1",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
